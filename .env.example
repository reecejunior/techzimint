# Copy to .env.local and fill in from the Firebase console:
# Project settings → General → Your apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ImgBB API key — enables uploading images from a device.
# Free, no card: https://api.imgbb.com  →  Get API key
# Public by necessity (it ships in the browser bundle); it is a quota key,
# not an account credential. Leave blank to fall back to pasted links.
NEXT_PUBLIC_IMGBB_API_KEY=

# ── Weekly digest email (server-only — never prefix these NEXT_PUBLIC_) ──
# See README.md's "Weekly digest email" section for full setup steps.

# Firebase service account JSON, base64-encoded (bypasses firestore.rules —
# only the digest/unsubscribe routes ever use it). Generate at:
# Firebase console → Project settings → Service accounts → Generate new private key
# Then: base64 -w0 the-downloaded-file.json   (macOS/Linux: base64 -i file.json)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Resend API key — sends the actual emails. Free tier, no card:
# https://resend.com → API Keys. Sending to real subscribers also requires
# verifying a sending domain there (DNS records), not just the API key.
RESEND_API_KEY=

# The verified "from" address, e.g. digest@techzim.co.zw
DIGEST_FROM_EMAIL=

# A random string you make up — Vercel Cron sends it back as a Bearer token
# so /api/cron/weekly-digest can tell a real scheduled run from a stranger
# hitting the URL. Any long random value works, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Used to build absolute links in the email (startup pages, unsubscribe).
# Defaults to https://startups.techzim.co.zw if unset.
NEXT_PUBLIC_SITE_URL=

# ── Video uploads (ImageKit) ──
# ImgBB is images-only and Firebase Storage needs the paid plan, so uploaded
# video goes to ImageKit. Free tier; signup works from Zimbabwe.
# imagekit.io → sign up → Developer options → API keys.
#
# The public key is public by design and ships in the browser bundle.
# The private key must NOT be prefixed NEXT_PUBLIC_ — it stays server-side
# and is used only by /api/upload-auth to mint a 2-minute upload signature.
# Leave both blank and the picker falls back to YouTube/Vimeo links only.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# ── Web push notifications ──
# Public by necessity (it ships in the browser bundle) — it's the public half
# of the VAPID key pair, not a secret. Generate at:
# Firebase console → Project settings → Cloud Messaging → Web Push certificates
# → Generate key pair. Leave blank and the "Enable push" button in the
# notification bell will show a setup error instead of silently doing nothing.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Regulations page: AI step (optional, server-only) ──
# /regulations always works with plain keyword matching. If these three are set,
# an open-weight model also reads the founder's idea and rates which rules in the
# directory apply, adds ones keywords missed and explains why. The model only
# picks rule ids from the directory: every fee, deadline and source on the page
# still comes from src/lib/regulationsData.ts.
#
# Any OpenAI-compatible chat-completions host works. Examples (check the host's
# own docs for the current model id, free-tier limits and JSON support):
#   Groq        REGS_AI_BASE_URL=https://api.groq.com/openai/v1
#               REGS_AI_MODEL=openai/gpt-oss-20b
#   OpenRouter  REGS_AI_BASE_URL=https://openrouter.ai/api/v1
#               REGS_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# The founder's idea text is sent to whichever host you choose.
# Set a spend/quota limit on the key; the per-IP limit in the route is in-memory.
REGS_AI_BASE_URL=
REGS_AI_API_KEY=
REGS_AI_MODEL=
# Optional: cap on the model's reply length (default 1200). Raise it for
# reasoning models that spend tokens thinking before they answer.
REGS_AI_MAX_TOKENS=
