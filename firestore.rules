rules_version = '2';

// Techzim Startups — public read, tightly-scoped anonymous writes.
//
// The Firebase API key in the client bundle is an identifier, not a secret.
// These rules are what actually protect the data, so keep them deployed:
//     firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin/review panel — active. isAdmin() below only matches the emails
    // listed there, so this opens nothing beyond those accounts. Every one of
    // them has full moderation power; there are no partial roles.
    function adminActive() {
      return true;
    }

    // Mirrors ADMIN_EMAILS in src/lib/firebase.ts — update both together.
    function isAdmin() {
      return adminActive() && signedIn()
             && request.auth.token.email in [
                  'chimutashureece@gmail.com',
                  'limbikani@techzim.co.zw',
                  'lufayi@techzim.co.zw',
                  'tavyromeo@gmail.com',
                  'theo@techzim.co.zw'
                ];
    }

    function mine() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }

    // `resource` is null when a document does not exist, and dereferencing it
    // denies the read. Toggling a like or a helpful mark reads the record first
    // to decide add-or-remove, so without the null branch nobody could ever
    // perform the *first* one.
    function mineOrMissing() {
      return signedIn() && (resource == null || resource.data.uid == request.auth.uid);
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function touched() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Counters move by exactly one per write, so no single request can inflate
    // a standing.
    function movedByOne(field) {
      return request.resource.data[field] == resource.data[field] + 1
          || request.resource.data[field] == resource.data[field] - 1;
    }

    // Weekly and monthly counters restart when their period rolls over. A reset
    // is only accepted together with a new period key, so a counter cannot be
    // rewritten while claiming to still be in the stored period.
    function countedForPeriod(countField, keyField) {
      return (unchanged(keyField) && movedByOne(countField))
          || (request.resource.data[keyField] != resource.data[keyField]
              && (request.resource.data[countField] == 0
                  || request.resource.data[countField] == 1));
    }

    function isRating(v) {
      return v is int && v >= 1 && v <= 5;
    }

    // Reviewer profiles ask for every review by one author across all startups,
    // which is a collectionGroup query. Those match at the group scope — a rule
    // nested under /startups/{id}/reviews does NOT cover them.
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }

    // Same reason: the feed is one collectionGroup query over every startup's
    // posts, so it needs a rule at the group scope to be readable at all.
    match /{path=**}/posts/{postId} {
      allow read: if true;
    }

    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    match /startups/{startupId} {
      allow read: if true;

      // Submissions go live immediately. Moderation is reactive: only the
      // console can set `rejected`, because `status` is frozen on update below.
      // A new startup still cannot arrive pre-loaded with engagement or wearing
      // an editorial badge it didn't earn.
      allow create: if signedIn()
                    && request.resource.data.status in ['approved', 'pending']
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.likeCount == 0
                    && request.resource.data.weeklyLikes == 0
                    && request.resource.data.monthlyLikes == 0
                    && request.resource.data.commentCount == 0
                    && request.resource.data.reviewCount == 0
                    && request.resource.data.postCount == 1
                    && request.resource.data.isStartupOfWeek == false
                    && request.resource.data.isTrending == false
                    && request.resource.data.prevRankWeek == 0
                    && request.resource.data.prevRankMonth == 0
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.tagline.size() <= 100
                    && request.resource.data.description.size() <= 2000
                    && request.resource.data.slug is string;

      // Engagement rolls up to the startup. Each branch may move only its own
      // counters; nothing that decides visibility or ownership can change.
      allow update: if signedIn()
                    && unchanged('status')
                    && unchanged('slug')
                    && unchanged('name')
                    && unchanged('ownerId')
                    && unchanged('isStartupOfWeek')
                    && (
                      // A like: the three like counters move together.
                      (movedByOne('likeCount')
                       && countedForPeriod('weeklyLikes', 'weekKey')
                       && countedForPeriod('monthlyLikes', 'monthKey')
                       && unchanged('commentCount')
                       && unchanged('reviewCount'))
                      ||
                      // A comment: one counter, nothing else.
                      (movedByOne('commentCount')
                       && touched().hasOnly(['commentCount']))
                      ||
                      // A post by the owner: one counter, nothing else.
                      (movedByOne('postCount')
                       && touched().hasOnly(['postCount'])
                       && resource.data.ownerId == request.auth.uid)
                      ||
                      // A review: the count grows by one and each rating sum
                      // grows by at most one review's worth (5 stars).
                      (request.resource.data.reviewCount == resource.data.reviewCount + 1
                       && unchanged('likeCount')
                       && unchanged('weeklyLikes')
                       && unchanged('monthlyLikes')
                       && unchanged('commentCount')
                       && request.resource.data.ratingSumUX >= resource.data.ratingSumUX + 1
                       && request.resource.data.ratingSumUX <= resource.data.ratingSumUX + 5
                       && request.resource.data.ratingSumUsefulness >= resource.data.ratingSumUsefulness + 1
                       && request.resource.data.ratingSumUsefulness <= resource.data.ratingSumUsefulness + 5
                       && request.resource.data.ratingSumWouldPay >= resource.data.ratingSumWouldPay + 1
                       && request.resource.data.ratingSumWouldPay <= resource.data.ratingSumWouldPay + 5)
                      ||
                      // A post removed by its owner: postCount drops by exactly
                      // one, and the totals that post had contributed may drop
                      // with it — bounded so a client can only ever take counts
                      // away, never invent new ones. Weekly/monthly like totals
                      // are untouched; see deletePost() for why.
                      ((resource.data.ownerId == request.auth.uid || isAdmin())
                       && request.resource.data.postCount == resource.data.postCount - 1
                       && request.resource.data.likeCount >= 0
                       && request.resource.data.likeCount <= resource.data.likeCount
                       && request.resource.data.commentCount >= 0
                       && request.resource.data.commentCount <= resource.data.commentCount
                       && unchanged('weeklyLikes')
                       && unchanged('monthlyLikes')
                       && unchanged('reviewCount')
                       && unchanged('ratingSumUX')
                       && unchanged('ratingSumUsefulness')
                       && unchanged('ratingSumWouldPay'))
                      ||
                      // A review edited by its own author: the review's doc id
                      // is their uid, so this can only be the same person who
                      // wrote it. reviewCount stays put — this replaces a
                      // rating, it doesn't add one — and each sum may move by
                      // at most one rating's full range (old 1–5 out, new 1–5
                      // in).
                      (unchanged('reviewCount')
                       && unchanged('likeCount')
                       && unchanged('weeklyLikes')
                       && unchanged('monthlyLikes')
                       && unchanged('commentCount')
                       && touched().hasOnly(['ratingSumUX', 'ratingSumUsefulness', 'ratingSumWouldPay'])
                       && request.resource.data.ratingSumUX >= resource.data.ratingSumUX - 4
                       && request.resource.data.ratingSumUX <= resource.data.ratingSumUX + 4
                       && request.resource.data.ratingSumUsefulness >= resource.data.ratingSumUsefulness - 4
                       && request.resource.data.ratingSumUsefulness <= resource.data.ratingSumUsefulness + 4
                       && request.resource.data.ratingSumWouldPay >= resource.data.ratingSumWouldPay - 4
                       && request.resource.data.ratingSumWouldPay <= resource.data.ratingSumWouldPay + 4)
                      ||
                      // The owner editing their own listing's presentable
                      // details. Identity (name/slug) and curation
                      // (category/region) are already frozen by the
                      // unchanged() checks above this whole OR block — this
                      // branch only needs to keep the write to these fields
                      // and validate what lands in them.
                      (resource.data.ownerId == request.auth.uid
                       && touched().hasOnly(['logoUrl', 'tagline', 'description', 'website', 'demo', 'apk', 'founders'])
                       && request.resource.data.tagline is string
                       && request.resource.data.tagline.size() <= 100
                       && request.resource.data.description is string
                       && request.resource.data.description.size() <= 2000
                       && request.resource.data.website is string
                       && request.resource.data.website.size() <= 300
                       && request.resource.data.demo is string
                       && request.resource.data.demo.size() <= 300
                       && request.resource.data.apk is string
                       && request.resource.data.apk.size() <= 300
                       && request.resource.data.logoUrl is string
                       && request.resource.data.logoUrl.size() <= 500
                       && request.resource.data.founders is list
                       && request.resource.data.founders.size() <= 6)
                    );

      // Admin decision: flips status between approved/rejected and records
      // why, touching nothing else. Independent of the community-engagement
      // rule above (which freezes status) — a separate `allow update` is
      // additive in Firestore rules, not a replacement.
      allow update: if isAdmin()
                    && request.resource.data.status in ['approved', 'rejected']
                    && touched().hasOnly(['status', 'rejectionReason'])
                    && (!('rejectionReason' in request.resource.data)
                        || request.resource.data.rejectionReason.size() <= 500);

      allow delete: if false;

      /* ── Posts ── */
      match /posts/{postId} {
        allow read: if true;

        // Only the founder who submitted the startup may post to it, and a new
        // post can never arrive pre-loaded with engagement.
        allow create: if signedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && get(/databases/$(database)/documents/startups/$(startupId)).data.ownerId == request.auth.uid
                      && request.resource.data.likeCount == 0
                      && request.resource.data.commentCount == 0
                      && request.resource.data.body is string
                      && request.resource.data.body.size() <= 2000
                      && request.resource.data.images.size() <= 4;

        // Anyone signed in may nudge a like or comment count; nothing else on
        // a post is editable this way, including by its author.
        allow update: if signedIn()
                      && (
                        (movedByOne('likeCount') && touched().hasOnly(['likeCount']))
                        ||
                        (movedByOne('commentCount') && touched().hasOnly(['commentCount']))
                      );

        // The owner changing their startup's logo (editStartup()) fans the
        // new URL out to every post already under it — the feed renders
        // from this denormalized copy rather than joining to the live
        // startup doc, so a stale copy here would make the edit invisible
        // everywhere that matters. get() re-checks ownership server-side
        // rather than trusting the client's claim.
        allow update: if signedIn()
                      && touched().hasOnly(['startupLogoUrl'])
                      && get(/databases/$(database)/documents/startups/$(startupId)).data.ownerId == request.auth.uid;

        // Admin decision: mirrors the parent startup's approve/reject onto
        // its posts. Nothing else on the post moves.
        allow update: if isAdmin() && touched().hasOnly(['approved']);

        // Admin correction: fixes the post's text, nothing else — images and
        // video stay exactly as posted.
        allow update: if isAdmin()
                      && touched().hasOnly(['body'])
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 2000;

        // The founder who owns this startup may remove a post they posted;
        // the admin may remove any post.
        allow delete: if signedIn()
                      && (get(/databases/$(database)/documents/startups/$(startupId)).data.ownerId == request.auth.uid
                          || isAdmin());

        match /comments/{commentId} {
          allow read: if true;

          allow create: if signedIn()
                        && request.resource.data.authorId == request.auth.uid
                        && request.resource.data.body is string
                        && request.resource.data.body.size() > 0
                        && request.resource.data.body.size() <= 1000
                        // isFounder is set from data the client can't fake:
                        // it must match whether this writer owns the startup.
                        && request.resource.data.isFounder ==
                           (get(/databases/$(database)/documents/startups/$(startupId)).data.ownerId == request.auth.uid)
                        // A reply's target must be a real, top-level comment —
                        // this keeps nesting at exactly one level: replying to
                        // a reply is rejected here, and the client instead
                        // re-parents it to the reply's own parent.
                        && (request.resource.data.parentId == null
                            || (request.resource.data.parentId is string
                                && get(/databases/$(database)/documents/startups/$(startupId)/posts/$(postId)/comments/$(request.resource.data.parentId)).data.parentId == null));

          // Comments are not editable. Deleting one at a time is an admin
          // moderation action; the founder can still remove a whole post,
          // which cascades its comments with it.
          allow update: if false;
          allow delete: if signedIn()
                        && (get(/databases/$(database)/documents/startups/$(startupId)).data.ownerId == request.auth.uid
                            || isAdmin());
        }
      }

      /* ── Reviews ── */
      match /reviews/{reviewId} {
        allow read: if true;

        // The doc id is the author's own uid — the same one-per-visitor
        // trick `likes` uses — so a second submission can only ever be an
        // update to this same document, never a second review.
        allow create: if signedIn()
                      && reviewId == request.auth.uid
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.helpfulCount == 0
                      && request.resource.data.isTrustedTester == false
                      && isRating(request.resource.data.ratingUX)
                      && isRating(request.resource.data.ratingUsefulness)
                      && isRating(request.resource.data.ratingWouldPay)
                      && request.resource.data.comment is string
                      && request.resource.data.comment.size() <= 1500;

        allow update: if signedIn()
                      && (
                        (movedByOne('helpfulCount') && touched().hasOnly(['helpfulCount']))
                        ||
                        // The author replacing their own rating and comment.
                        (reviewId == request.auth.uid
                         && touched().hasOnly(['authorName', 'authorAvatar', 'isFounder', 'ratingUX', 'ratingUsefulness', 'ratingWouldPay', 'comment'])
                         && isRating(request.resource.data.ratingUX)
                         && isRating(request.resource.data.ratingUsefulness)
                         && isRating(request.resource.data.ratingWouldPay)
                         && request.resource.data.comment is string
                         && request.resource.data.comment.size() <= 1500)
                      );

        allow delete: if false;
      }
    }

    // One like per (post, visitor). The id encodes both, so a second like for
    // the same post collides with the first.
    match /likes/{likeId} {
      allow read: if mineOrMissing();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && likeId == request.resource.data.postId + '__' + request.auth.uid;
      allow delete: if mine();
      allow update: if false;
    }

    match /helpful/{markId} {
      allow read: if mineOrMissing();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && markId == request.resource.data.reviewId + '__' + request.auth.uid;
      allow delete: if mine();
      allow update: if false;
    }

    // ═══ Community ═══════════════════════════════════════════════
    // Developer Q&A, show-and-tell and polls. Independent of /startups
    // entirely — nothing in this section reads or writes a startup, and no
    // rule below ever mentions score/rank/rankHistory/scoreWeek or any other
    // ranking field, because this feature does not touch the ranking system
    // at all. Open to any signed-in visitor (anonymous auth, same as the rest
    // of the site) — there is no ownership check tying posting here to the
    // startup directory.
    match /communityPosts/{postId} {
      allow read: if true;

      // Anyone signed in may start a thread. A new post can never arrive
      // pre-loaded with engagement, already "answered", or hidden —
      // moderation here is reactive (same as startups/posts), not a queue.
      allow create: if signedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.kind in ['question', 'showcase', 'poll']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 140
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 4000
                    && request.resource.data.tags is list
                    && request.resource.data.tags.size() <= 5
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0
                    && request.resource.data.isAnswered == false
                    && request.resource.data.acceptedCommentId == null
                    // pollOptions is only meaningful on a poll — a question or
                    // showcase must arrive with it empty, the same
                    // kept-inert-outside-its-own-branch convention isAnswered/
                    // acceptedCommentId already follow above. On a poll it's
                    // 2–6 options, each a non-empty id and a non-empty,
                    // length-capped label — checked per-element with .all()
                    // rather than spelled out by index, since the count is
                    // variable.
                    && request.resource.data.pollOptions is list
                    && (request.resource.data.kind == 'poll'
                        ? (request.resource.data.pollOptions.size() >= 2
                           && request.resource.data.pollOptions.size() <= 6
                           && request.resource.data.pollOptions.all(o,
                                o.id is string && o.id.size() > 0
                                && o.label is string && o.label.size() > 0 && o.label.size() <= 80))
                        : request.resource.data.pollOptions.size() == 0)
                    && request.resource.data.approved == true;

      // Anyone signed in may nudge the like counter — nothing else about the
      // post moves this way, not even by its own author.
      allow update: if signedIn()
                    && movedByOne('likeCount')
                    && touched().hasOnly(['likeCount']);

      // A new comment bumps this post's own counter — nothing else moves
      // this way either.
      allow update: if signedIn()
                    && movedByOne('commentCount')
                    && touched().hasOnly(['commentCount']);

      // The question's own author accepting (or un-accepting) one reply as
      // the answer. Gated three ways: only the author (resource.data.authorId,
      // i.e. who *already* owns this doc — not the incoming write, so this
      // can't be forged by also rewriting authorId, which touched() already
      // forbids by not listing it), only on a `kind: 'question'` post (a
      // showcase can never become "answered"), and — rather than trust
      // whatever id the client sends — the target must be a real, top-level
      // comment that actually lives under this same post, the same way a
      // reply's own parentId is checked below.
      allow update: if signedIn()
                    && resource.data.authorId == request.auth.uid
                    && resource.data.kind == 'question'
                    && touched().hasOnly(['isAnswered', 'acceptedCommentId'])
                    && ((request.resource.data.isAnswered == false
                         && request.resource.data.acceptedCommentId == null)
                        || (request.resource.data.isAnswered == true
                            && request.resource.data.acceptedCommentId is string
                            && get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(request.resource.data.acceptedCommentId)).data.parentId == null));

      // Admin moderation: pulls a post out of the feed (or restores it)
      // without touching anything else — mirrors startups' posts.
      allow update: if isAdmin() && touched().hasOnly(['approved']);

      // No delete in this first slice — an admin pulls a post from the feed
      // via `approved` instead of removing it outright.
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if true;

        allow create: if signedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.postId == postId
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 2000
                      && request.resource.data.isAccepted == false
                      && request.resource.data.likeCount == 0
                      // A reply's target must be a real, top-level comment —
                      // keeps nesting at exactly one level, same rule as the
                      // startup comments above: replying to a reply is
                      // rejected here, and the client re-parents it to the
                      // reply's own parent instead.
                      && (request.resource.data.parentId == null
                          || (request.resource.data.parentId is string
                              && get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(request.resource.data.parentId)).data.parentId == null));

        // Comments are not editable by their own author — the one exception
        // is the parent post's author flipping `isAccepted`, and only on a
        // top-level reply under a question of theirs. get() re-checks that
        // ownership server-side rather than trusting the client's claim, the
        // same way the parent post's own accept-answer branch does.
        allow update: if signedIn()
                      && touched().hasOnly(['isAccepted'])
                      && resource.data.parentId == null
                      && get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId == request.auth.uid
                      && get(/databases/$(database)/documents/communityPosts/$(postId)).data.kind == 'question';

        // Anyone signed in may nudge a reply's own like counter — same shape
        // as the post-level like rule above, scoped to this one comment so
        // a good answer can surface without touching the post or anything
        // ranking reads.
        allow update: if signedIn()
                      && movedByOne('likeCount')
                      && touched().hasOnly(['likeCount']);

        allow delete: if false;
      }
    }

    // One like per (community post, visitor) — the same `postId__uid` id
    // trick as /likes, but its own collection: a community post's id can
    // never collide with a startup post's id in a like record, because the
    // two never share a collection to collide in.
    match /communityLikes/{likeId} {
      allow read: if mineOrMissing();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && likeId == request.resource.data.postId + '__' + request.auth.uid;
      allow delete: if mine();
      allow update: if false;
    }

    // One like per (community comment, visitor) — mirrors /communityLikes
    // exactly, scoped to an individual reply instead of a whole post.
    match /communityCommentLikes/{likeId} {
      allow read: if mineOrMissing();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && likeId == request.resource.data.commentId + '__' + request.auth.uid;
      allow delete: if mine();
      allow update: if false;
    }

    // One vote per (poll post, visitor) — same postId__uid id trick as
    // /communityLikes, but its own collection and, unlike likes, publicly
    // readable in full: a poll's tallies are computed by subscribing to
    // every vote for a post and counting them in memory (see
    // subscribeToCommunityPollVotes / useCommunityPollVotes), so any visitor
    // reading a poll's results needs every vote doc, not only their own —
    // intentionally wider than mineOrMissing().
    match /communityPollVotes/{voteId} {
      allow read: if true;

      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && voteId == request.resource.data.postId + '__' + request.auth.uid
                    && request.resource.data.optionId is string
                    && request.resource.data.optionId.size() > 0
                    && get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.kind == 'poll';

      // Changing an existing vote: same visitor, same post — only the chosen
      // option (and its timestamp) may actually move.
      allow update: if mine()
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.postId == resource.data.postId
                    && touched().hasOnly(['optionId', 'createdAt'])
                    && request.resource.data.optionId is string
                    && request.resource.data.optionId.size() > 0;

      // Retracting a vote entirely.
      allow delete: if mine();
    }

    // The hackathon tracker's correction/addition intake queue (see the
    // TrackerSuggestion doc comment in src/lib/types.ts). Unreadable by
    // clients other than admins — same reasoning as the weekly-digest list
    // just below: a raw, unreviewed submission is not meant to be public,
    // and this keeps the queue from doubling as a free-for-all comment feed.
    // The tracker's own data file only ever changes through a reviewed code
    // update, never automatically from here.
    match /trackerSuggestions/{suggestionId} {
      allow read: if isAdmin();

      allow create: if signedIn()
                    && request.resource.data.submittedBy == request.auth.uid
                    && request.resource.data.winnerId is string
                    && request.resource.data.winnerId.size() <= 10
                    && request.resource.data.winnerName is string
                    && request.resource.data.winnerName.size() <= 140
                    && request.resource.data.note is string
                    && request.resource.data.note.size() > 0
                    && request.resource.data.note.size() <= 1000
                    && request.resource.data.evidenceUrl is string
                    && request.resource.data.evidenceUrl.size() <= 300
                    && request.resource.data.submitterName is string
                    && request.resource.data.submitterName.size() <= 80
                    && request.resource.data.status == 'pending'
                    && request.resource.data.reviewedAt == null
                    && request.resource.data.reviewNote == '';

      // Only an admin marks one reviewed — status plus their own note on
      // what they did about it, nothing else about the submission moves.
      allow update: if isAdmin()
                    && request.resource.data.status in ['applied', 'dismissed']
                    && touched().hasOnly(['status', 'reviewedAt', 'reviewNote']);

      allow delete: if false;
    }

    // Reviewer profiles are editorial content — readable by all, writable only
    // from the seed script or the console.
    match /reviewers/{reviewerId} {
      allow read: if true;
      allow write: if false;
    }

    // The weekly-digest mailing list. Deliberately unreadable by clients —
    // an email address is more sensitive than anything else this app stores,
    // and there is no legitimate reason a browser needs to list it. Only the
    // Admin-SDK-backed send job (src/lib/server/) ever reads it, which
    // bypasses these rules entirely.
    match /subscribers/{subscriberId} {
      allow read: if false;

      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['email', 'active', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$')
                    && request.resource.data.active == true;

      // Unsubscribing goes through /api/unsubscribe (Admin SDK), not a
      // client write — a link in an email has no session to authenticate.
      allow update: if false;
      allow delete: if false;
    }

    // A notification is written by the actor (liker/commenter/reviewer/
    // founder-replying) but addressed to someone else — the recipient can
    // only ever read and mark-read their own, never the actor's identity.
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;

      allow create: if signedIn()
                    && request.resource.data.recipientId is string
                    && request.resource.data.recipientId != request.auth.uid
                    && request.resource.data.type in ['reply', 'like', 'comment', 'review']
                    && request.resource.data.startupId is string
                    && request.resource.data.read == false
                    && request.resource.data.actorName is string
                    && request.resource.data.actorName.size() <= 60
                    && request.resource.data.snippet is string
                    && request.resource.data.snippet.size() <= 200;

      // The recipient may only flip it to read — nothing else about a
      // notification is theirs to change.
      allow update: if signedIn()
                    && resource.data.recipientId == request.auth.uid
                    && touched().hasOnly(['read']);

      allow delete: if false;
    }

    // A visitor's own opt-in for getting their notifications by email too.
    // Doc id is their own uid, so this is naturally one-per-visitor and only
    // they can ever read or write it. The send jobs run server-side with the
    // Admin SDK and never go through these rules at all.
    match /notificationPrefs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow write: if signedIn()
                   && request.auth.uid == uid
                   && request.resource.data.mode in ['instant', 'daily', 'off']
                   && request.resource.data.email is string
                   && request.resource.data.email.size() <= 200
                   && (request.resource.data.mode == 'off'
                       || request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$'));
    }

    // Web push tokens — one doc per visitor, an array because one uid can
    // span more than one browser/device. The /api/push/notify route reads
    // this with the Admin SDK, bypassing these rules entirely.
    match /pushTokens/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow write: if signedIn()
                   && request.auth.uid == uid
                   && request.resource.data.tokens is list
                   && request.resource.data.tokens.size() <= 10;
    }
  }
}
